# Copy to .env and adjust for local development (docker-compose defaults shown).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
REDIS_URL=redis://localhost:6379/0

# Optional worker / simulation toggles
# WORKER_ID=local-worker-1
# JOB_SIMULATION_DELAY=3
# SIMULATE_JOB_FAILURE=0
